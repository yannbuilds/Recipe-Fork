{
  "name": "recipe-aggregator",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build:shared && patch-package",
    "build:shared": "npm run build -w packages/shared",
    "dev:web": "npm run dev -w packages/web",
    "build:web": "npm run build -w packages/web",
    "dev:extension": "npm run dev -w packages/extension",
    "dev:mobile": "npm run start -w packages/mobile",
    "build:extension": "npm run build -w packages/extension",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json",
    "test:recipe-extraction": "tsx scripts/test-recipe-schema.ts",
    "test:social-source": "tsx scripts/test-social-source.ts",
    "smoke:social-source": "tsx scripts/smoke-social-source.ts",
    "smoke:social-import:production": "tsx scripts/smoke-production-social-import.ts",
    "check:recipe-extraction:live": "tsx scripts/check-live-recipe-schema.ts",
    "smoke:recipe-import:production": "tsx scripts/smoke-production-recipe-import.ts",
    "soak:recipe-import:production": "tsx scripts/soak-production-recipe-import.ts"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-keep-awake": "~15.0.8",
    "expo-router": "~6.0.24",
    "patch-package": "^8.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "typescript": "5.9.3",
    "tsx": "^4.22.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0"
  }
}
